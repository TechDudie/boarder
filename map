    var teams   = [{"id":1,"name":"Team 1","number":1,"house":{"name":"Blue","color":"#0355D1"}},{"id":2,"name":"Team 1","number":1,"house":{"name":"Green","color":"#89C400"}},{"id":9,"name":"Team 1","number":1,"house":{"name":"Orange","color":"#FF681C"}},{"id":13,"name":"Team 1","number":1,"house":{"name":"Yellow","color":"#FECB0D"}},{"id":6,"name":"Team 2","number":2,"house":{"name":"Green","color":"#89C400"}},{"id":10,"name":"Team 2","number":2,"house":{"name":"Orange","color":"#FF681C"}},{"id":3,"name":"Team 2","number":2,"house":{"name":"Blue","color":"#0355D1"}},{"id":14,"name":"Team 2","number":2,"house":{"name":"Yellow","color":"#FECB0D"}},{"id":4,"name":"Team 3","number":3,"house":{"name":"Blue","color":"#0355D1"}},{"id":7,"name":"Team 3","number":3,"house":{"name":"Green","color":"#89C400"}},{"id":15,"name":"Team 3","number":3,"house":{"name":"Yellow","color":"#FECB0D"}},{"id":11,"name":"Team 3","number":3,"house":{"name":"Orange","color":"#FF681C"}},{"id":16,"name":"Team 4","number":4,"house":{"name":"Yellow","color":"#FECB0D"}},{"id":12,"name":"Team 4","number":4,"house":{"name":"Orange","color":"#FF681C"}},{"id":8,"name":"Team 4","number":4,"house":{"name":"Green","color":"#89C400"}},{"id":5,"name":"Team 4","number":4,"house":{"name":"Blue","color":"#0355D1"}}];

    console.log(`[map] Data loaded — ${airtagMarkers.length} AirTag marker(s), ${zones.length} zone(s), ${teams.length} team(s)`);

    var myLocation   = {"lat":40.7986919,"lng":-73.9663741};

    var zoneIndex = {};
    zones.forEach(function(z) { zoneIndex[String(z.id)] = z; });

    var polyIndex = {};
    var selectedId = null;
    var map;
    var defaultCenter = myLocation ? [myLocation.lat, myLocation.lng] : [40.7549, -73.9840];
    var defaultZoom   = myLocation ? 16 : 13;

    // ── Sheet expand/collapse ──
    // When the sheet covers part of the map, we shift the map so the
    // currently-visible geo center stays at the visible (unobstructed) center.
    var appliedSheetOffset = 0;
    var COLLAPSED_PEEK_PX = 68; // ~4.25rem — the bit that peeks above the tab bar

    function isMobileLayout() {
      return window.matchMedia('(max-width: 1023px)').matches;
    }

    function adjustMapForSheet(animate) {
      if (!map) return;
      if (!isMobileLayout()) {
        if (appliedSheetOffset !== 0) {
          map.panBy([0, -appliedSheetOffset], { animate: false });
          appliedSheetOffset = 0;
        }
        return;
      }
      var sheet = document.getElementById('map-sheet');
      var inner = sheet && sheet.querySelector('.map-sheet-inner');
      if (!inner) return;
      var expanded = sheet.dataset.state === 'expanded';
      var coveredHeight = expanded ? inner.offsetHeight : COLLAPSED_PEEK_PX;
      var targetOffset = Math.max(0, (coveredHeight - COLLAPSED_PEEK_PX) / 2);
      var delta = targetOffset - appliedSheetOffset;
      if (Math.abs(delta) > 1) {
        map.panBy([0, delta], { animate: animate !== false, duration: 0.3 });
        appliedSheetOffset = targetOffset;
      }
    }

    // Pan to a latlng such that it lands at the visible center (above the sheet).
    function panToVisible(latlng) {
      if (!map) return;
      if (!appliedSheetOffset) {
        map.panTo(latlng);
        return;
      }
      var pt = map.project(latlng, map.getZoom());
      var newCenter = map.unproject(pt.add([0, appliedSheetOffset]), map.getZoom());
      map.panTo(newCenter);
    }

    function setSheetState(state) {
      var sheet = document.getElementById('map-sheet');
      sheet.dataset.state = state;
      var icon = document.getElementById('sheet-toggle-icon');
      if (icon) icon.style.transform = state === 'expanded' ? 'rotate(180deg)' : 'rotate(0deg)';
      adjustMapForSheet(true);
    }
    function toggleSheet() {
      var sheet = document.getElementById('map-sheet');
      setSheetState(sheet.dataset.state === 'expanded' ? 'collapsed' : 'expanded');
    }
    window.toggleSheet = toggleSheet;

    function expandSheet() { setSheetState('expanded'); }

    // ── Selection ──
    function renderDetail(zone) {
      if (!zone) return '';
      if (!zone.challenge) {
        return '<p class="text-gray-400 italic">No challenge linked to this zone.</p>';
      }
      var c = zone.challenge;
      var statusLabel = { unclaimed: 'Open', pending: 'In progress', claimed: 'Claimed' }[zone.status] || zone.status;
      var statusClass = zone.status === 'pending'
        ? 'pill-yellow'
        : zone.status === 'claimed'
        ? 'pill-dark'
        : 'pill-gray';
      var html  = '<p class="font-black text-black leading-snug">' + c.title + '</p>';
          html += '<div class="flex flex-row gap-2 items-center mt-1.5">'
                + '<span class="' + statusClass + '">' + statusLabel + '</span>'
                + '<span class="text-gray-500 font-mono text-xs">' + c.value + ' pts/hr</span>'
                + '</div>';
          html += '<div class="text-sm text-gray-700 mt-2">' + c.description + '</div>';
      if (c.team) html += '<p class="text-xs text-gray-500 mt-2">Claimed by <strong>' + c.team + '</strong></p>';
      return html;
    }

    function closeAllRows() {
      document.querySelectorAll('.zone-row.open').forEach(function(el) {
        el.classList.remove('open');
      });
    }

    function selectZoneInternal(id, opts) {
      opts = opts || {};
      id = String(id);
      var zone = zoneIndex[id];
      if (!zone) {
        console.warn(`[map] selectZone: zone ${id} not found in index`);
        return;
      }

      // Toggle row state
      var row = document.querySelector('.zone-row[data-zone-id="' + id + '"]');
      var detailEl = document.querySelector('[data-zone-detail="' + id + '"]');
      var wasOpen = row && row.classList.contains('open');

      closeAllRows();

      if (!wasOpen || opts.forceOpen) {
        console.log(`[map] Zone selected — id: ${id}, name: "${zone.name || '(unnamed)'}", status: ${zone.status}`);
        if (detailEl) detailEl.innerHTML = renderDetail(zone);
        if (row) {
          row.classList.add('open');
          // Scroll the row into view inside the list
          if (row.scrollIntoView) {
            row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
        selectedId = id;

        // Pan map (accounting for the sheet covering the bottom on mobile)
        if (map && zone.coordinates && zone.coordinates.length > 0) {
          var lat = zone.coordinates.reduce(function(s, c) { return s + c.lat; }, 0) / zone.coordinates.length;
          var lng = zone.coordinates.reduce(function(s, c) { return s + c.lng; }, 0) / zone.coordinates.length;
          panToVisible([lat, lng]);
        }
      } else {
        console.log(`[map] Zone deselected — id: ${id}`);
        selectedId = null;
      }

      // Polygon highlight
      Object.keys(polyIndex).forEach(function(pid) {
        polyIndex[pid].setStyle({ weight: 2, opacity: 0.9, fillOpacity: 0.15 });
      });
      if (selectedId && polyIndex[selectedId]) {
        polyIndex[selectedId].setStyle({ weight: 4, opacity: 1, fillOpacity: 0.35 });
      }
    }

    // From the list — toggle behaviour
    window.toggleZone = function(id) { selectZoneInternal(id); };

    // From the map polygon — force-open and reveal the sheet
    function selectZoneFromMap(id) {
      expandSheet();
      selectZoneInternal(id, { forceOpen: true });
    }

    window.deselectZone = function() {
      closeAllRows();
      Object.keys(polyIndex).forEach(function(pid) {
        polyIndex[pid].setStyle({ weight: 2, opacity: 0.9, fillOpacity: 0.15 });
      });
      selectedId = null;
    };

    window.recenterMap = function() {
      if (!map) return;
      // Account for sheet offset so the city center lands at the visible center
      var target = defaultCenter;
      if (appliedSheetOffset) {
        var pt = map.project(target, defaultZoom);
        target = map.unproject(pt.add([0, appliedSheetOffset]), defaultZoom);
