        <script>
          (function () {
            var sheet    = document.getElementById('profile-sheet');
            var backdrop = document.getElementById('profile-sheet-backdrop');
            var panel    = document.getElementById('profile-sheet-panel');
            var closing  = false;

            function clearAnim(el, cls) { if (el) el.classList.remove(cls); }

            window.openProfileSheet = function () {
              if (!sheet) return;
              closing = false;
              sheet.classList.remove('hidden');
              clearAnim(panel,    'slide-down-out');
              clearAnim(backdrop, 'fade-out');
              clearAnim(panel,    'slide-up'); void panel.offsetWidth;
              clearAnim(backdrop, 'fade-in');  void backdrop.offsetWidth;
              panel.classList.add('slide-up');
              backdrop.classList.add('fade-in');
            };

            window.closeProfileSheet = function () {
              if (!sheet || sheet.classList.contains('hidden') || closing) return;
              closing = true;
              clearAnim(panel,    'slide-up');
              clearAnim(backdrop, 'fade-in');
              // Force reflow so the browser registers the class swap as a new animation
              void panel.offsetWidth;
              void backdrop.offsetWidth;
              panel.classList.add('slide-down-out');
              backdrop.classList.add('fade-out');
              var done = function () {
                panel.removeEventListener('animationend', done);
                if (!closing) return; // a reopen happened mid-close
                sheet.classList.add('hidden');
                clearAnim(panel,    'slide-down-out');
                clearAnim(backdrop, 'fade-out');
                closing = false;
              };
              panel.addEventListener('animationend', done);
            };
          })();
        </script>
