    function buildTeamPopup(m) {
      var html = '<div style="font-size:13px;min-width:160px">';
      html += '<p style="font-weight:700;margin:0 0 2px">' + m.teamName + '</p>';
      html += '<p style="color:#6b7280;margin:0 0 8px;font-size:11px">' + m.timeAgo + ' ago</p>';
      if (m.members && m.members.length > 0) {
        html += '<div style="display:flex;flex-wrap:wrap;gap:8px">';
        m.members.forEach(function(u) {
          html += '<div style="display:flex;flex-direction:column;align-items:center;gap:3px;width:52px">';
          html += '<img src="' + u.avatarUrl + '" style="width:40px;height:40px;border-radius:50%;border:2px solid #111827;object-fit:cover" onerror="this.style.display=\'none\'">';
          html += '<span style="font-size:10px;font-weight:600;text-align:center;line-height:1.2;word-break:break-word">' + u.name + '</span>';
          html += '</div>';
        });
        html += '</div>';
      }
      html += '</div>';
      return html;
    }

    airtagMarkers.forEach(function(m) {
      var icon = L.icon({
        iconUrl: m.avatarUrl,
        shadowUrl: m.backgroundUrl,
        iconSize: [30, 30],
        shadowSize: [35, 35],
        className: "rounded-full",
        shadowAnchor: [18, 18]
      });
      var marker = L.marker([m.lat, m.lng], { icon }).addTo(map);
      marker.bindPopup(buildTeamPopup(m), { maxWidth: 260 });
      console.log(`[map] AirTag marker placed — team: "${m.teamName}", lat: ${m.lat?.toFixed(6)}, lng: ${m.lng?.toFixed(6)}, last seen: ${m.timeAgo} ago`);
    });

    var skippedZones = 0;
    zones.forEach(function(zone) {
      if (!zone.coordinates || zone.coordinates.length === 0) {
        skippedZones++;
        return;
      }
      var latlngs = zone.coordinates.map(function(c) { return [c.lat, c.lng]; });
      var status = zone.status;
      var strokeColor, fillColor, fillOpacity;
      if (status === "claimed") {
        strokeColor = zone.current_claim.team.house.color;
        fillColor   = strokeColor;
        fillOpacity = 0.2;
      } else if (status === "pending") {
        strokeColor = "#fbbf24";
        fillColor   = "#fbbf24";
        fillOpacity = 0.15;
      } else {
        strokeColor = "#111827";
        fillColor   = "#111827";
        fillOpacity = 0.1;
      }

      var poly = L.polygon(latlngs, {
        color: strokeColor, opacity: 0.9, weight: 2,
        fillColor: fillColor, fillOpacity: fillOpacity
      }).addTo(map);

      polyIndex[String(zone.id)] = poly;
      poly.on('click', function(e) {
        L.DomEvent.stopPropagation(e);
        selectZoneFromMap(String(zone.id));
      });
    });
    console.log(`[map] Zones rendered — ${zones.length - skippedZones} polygon(s) added, ${skippedZones} skipped (no coordinates)`);

    map.on('click', function() { deselectZone(); });

    // Ensure Leaflet sizes correctly after layout settles
    setTimeout(function() {
      map.invalidateSize();
      console.log('[map] invalidateSize() called after layout settle');
    }, 50);
    window.addEventListener('resize', function() {
      map.invalidateSize();
      adjustMapForSheet(false);
    });
  })();
</script>

